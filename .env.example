# Copy this file to .env and replace all placeholder values.
#
# Backblaze B2 backup settings. These configure the S3-compatible destination
# where Meeting Memory uploads each meeting's `recording.m4a` and `transcript.md`.
# Use a bucket dedicated to Meeting Memory and an application key restricted to
# that bucket; do not reuse sample-app buckets.
B2_APPLICATION_KEY_ID=replace-me
B2_APPLICATION_KEY=replace-me
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET_NAME=replace-me

# Transcription settings. AssemblyAI receives the completed recording and
# returns diarized speaker-labeled transcript segments for `transcript.md`.
#
# Required AssemblyAI API key used by the transcription adapter.
ASSEMBLYAI_API_KEY=replace-me

# Summary settings. Anthropic is optional: leave `ANTHROPIC_API_KEY` blank to
# keep transcription working while skipping derived notes generation.
# Claude API key and model used by `meeting-memory summarize` to generate
# `notes.md` after speaker aliases are confirmed.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
#
# Prompt file for summary generation. If it contains `{transcript}`, the app
# replaces that placeholder; otherwise it appends the transcript below it.
SUMMARY_PROMPT_FILE=prompts/summary.md
# Optional JSON file for replacing AssemblyAI speaker labels in rendered transcript,
# for example {"Speaker A": "Alex"}.
SPEAKER_MAPPING_FILE=
# Optional comma-separated aliases for people whose names should be normalized
# in Calendar-derived speaker candidates, for example Alex,Blair.
KNOWN_SPEAKERS=

# Google Calendar settings. These let the app find upcoming Meet or Zoom events
# and notify you before they start. OAuth tokens are stored in macOS Keychain,
# not in `.env`.
# Path to the Google OAuth Desktop App client JSON downloaded from Google Cloud.
GOOGLE_CALENDAR_CREDENTIALS_FILE=credentials.json
# Calendar scope to watch. Use `all` for every accessible calendar, `primary`
# for the main calendar, or a specific Google Calendar ID.
GOOGLE_CALENDAR_ID=all

# Local app behavior.
#
# Folder where completed meeting directories are created locally.
MEETINGS_DIR=~/Meetings
# macOS audio input device used for recording. Usually this is an aggregate
# device combining microphone input and routed system audio.
AUDIO_DEVICE=Meeting Aggregate
#
# How many minutes before a detected calendar meeting the app sends a reminder.
NOTIFY_MINUTES_BEFORE=5
#
# Recording safety limit, in minutes. Active recordings are stopped
# automatically when this limit is reached.
MAX_RECORDING_MINUTES=180
#
# How often, in seconds, the background watcher checks Google Calendar.
CALENDAR_POLL_INTERVAL=120
